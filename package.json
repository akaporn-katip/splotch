{
  "name": "splotch-ui",
  "version": "0.1.0",
  "description": "A cartoon component kit for React: Radix primitives underneath, cut paper on top. Twenty-one parts printed in misregistered spot inks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akaporn-katip/splotch.git"
  },
  "homepage": "https://github.com/akaporn-katip/splotch#readme",
  "bugs": {
    "url": "https://github.com/akaporn-katip/splotch/issues"
  },
  "keywords": [
    "react",
    "radix-ui",
    "tailwindcss",
    "component-library",
    "design-system",
    "cartoon",
    "accessibility"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist-lib"
  ],
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js",
      "default": "./dist-lib/index.js"
    },
    "./index.css": {
      "types": "./dist-lib/style.d.ts",
      "default": "./dist-lib/style.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --mode lib && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "shot": "node scripts/shoot.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "prepublishOnly": "npm run build:lib && npm run audit:contrast"
  },
  "dependencies": {
    "@fontsource/alfa-slab-one": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.56.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
